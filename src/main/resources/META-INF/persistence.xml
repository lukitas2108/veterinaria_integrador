<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="veterinariaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- A medida que se vayan creando las entidades JPA, se agregan acá con <class>. -->
        <class>com.veterinaria.modelo.Cliente</class>
        <class>com.veterinaria.modelo.Mascota</class>

        <properties>
            <!-- H2 en modo archivo: los datos persisten entre ejecuciones en ./data/veterinaria.mv.db -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:file:./data/veterinaria;AUTO_SERVER=TRUE"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <!-- update: crea/actualiza tablas automáticamente según las entidades. -->
            <!-- Cambiar a "validate" cuando el modelo esté estable, para evitar pérdida de datos. -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
